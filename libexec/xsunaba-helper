#!/usr/bin/perl -T

#
# xsunaba-helper - privileged session launcher for Xsunaba
#
# Runs as root via a narrowly scoped doas.conf rule (see README.md).
# Creates one isolated Xephyr session and runs one application under
# dedicated, non-login Unix accounts.
#
# The caller may only provide:
#   - the parent (real) display and its Xauthority file,
#   - a starting display number, window geometry and optional unveil
#     entries,
#   - the application command line to run.
#
# The helper selects the actual nested display, creates the session
# directory, generates the authentication material, drops to the
# dedicated UIDs and performs all cleanup. No environment variable,
# session directory, socket pathname or Xauthority file may be
# injected by the caller.
#

package Xsunaba::Helper;

use strict;
use warnings;
use Exporter   qw(import);
use Fcntl      qw(O_CREAT O_EXCL O_RDONLY O_RDWR O_WRONLY :flock
                  S_IFMT S_IFSOCK S_IFDIR);
use File::Path qw(remove_tree);
use POSIX      qw(_exit WNOHANG getegid geteuid getgid getgroups getgrnam
                  getpwnam getuid setgid setuid);
use Sys::Hostname qw(hostname);

our @EXPORT_OK = qw(
  parse_args find_free_display socket_path xauth_record_bytes
  write_xauth_file parse_xauth_bytes read_xauth_file
  extract_parent_auth parent_display_number xauth_records_for
  gen_cookie build_app_env build_xephyr_env build_unveil_entries
  build_xephyr_argv make_session_dir path_exists exit_status
  gen_account_name build_useradd_argv build_userdel_argv
  build_groupdel_argv build_pkill_argv home_safe_to_delete
  _passthrough
);
our %EXPORT_TAGS = ( all => \@EXPORT_OK );

use constant FAMILY_LOCAL => 256;    # FamilyLocal
use constant FAMILY_WILD  => 65535;  # FamilyWild

# Fixed paths and account names. The helper refuses to proceed if the
# accounts do not exist with the expected relationship.
our $RUN_DIR       = '/var/run/xsunaba';
our $SOCKET_DIR    = '/tmp/.X11-unix';
our $XEPHYR_BIN    = '/usr/X11R6/bin/Xephyr';
our $XEPHYR_USER   = '_xsunaba_xephyr';
our $APP_USER      = '_xsunaba_app';
our $APP_GROUP     = '_xsunaba';
our $APP_PATH      = '/usr/local/bin:/usr/X11R6/bin:/usr/bin:/bin';
our $MINIMAL_PATH  = '/usr/X11R6/bin:/usr/bin:/bin';
our $MAX_DISPLAY   = 999;
our $SOCKET_MODE   = 0660;
our $MAX_AUTH_LEN  = 4096;
our $MAX_XAUTH     = 1048576;  # 1 MiB
our $COOKIE_LEN    = 16;
our $VERBOSE       = 0;

# Amnesiac mode: a fresh Unix user per session.
our $EPHEMERAL_PREFIX    = '_xsunaba_';
our $EPHEMERAL_TOKEN_LEN = 16;      # hex chars in the account name
our $EPHEMERAL_HOME_BASE = '/var/xsunaba/home';
our $EPHEMERAL_SHELL     = '/sbin/nologin';
our $USERADD_BIN = '/usr/sbin/useradd';
our $USERDEL_BIN = '/usr/sbin/userdel';
our $GROUPDEL_BIN = '/usr/sbin/groupdel';
our $PKILL_BIN   = '/usr/bin/pkill';

our @PASSTHROUGH_ENV = qw(TERM TZ LANG LC_ALL LC_CTYPE LC_MESSAGES);

sub _inf { print "[INFO] @_\n" if $VERBOSE }
sub _wrn { print STDERR "[WARN] @_\n" }
sub _err { print STDERR "[ERROR] @_\n" }

sub _untaint {
    my ($value, $what) = @_;
    defined $value or die "missing $what";
    die "$what contains a NUL byte" if $value =~ /\0/;
    my ($clean) = $value =~ /\A(.*)\z/s;
    return $clean;
}

#
# Argument parsing. Returns a hash reference or dies with a
# descriptive error. Nothing from the environment is consulted.
#
sub parse_args {
    my (@argv) = @_;
    my %o = ( verbose => 0 );

    my $usage = sub {
        die "usage: xsunaba-helper --parent-display :N "
          . "--parent-xauth FILE [--display N] [--width N] "
          . "[--height N] [--unveil PATH:PERM,...] [--amnesiac] "
          . "[--verbose] -- APP [ARGS...]\n";
    };

    my $need = sub {
        my ($name, $value) = @_;
        $usage->() unless defined $value && length $value;
        return $value;
    };

    my $i = 0;
    while ( $i < @argv ) {
        my $a = $argv[$i];
        last if $a eq '--';
        if    ( $a eq '--parent-display' ) {
            $o{parent_display} = $need->( $a, $argv[ ++$i ] );
        }
        elsif ( $a eq '--parent-xauth' ) {
            $o{parent_xauth} = $need->( $a, $argv[ ++$i ] );
        }
        elsif ( $a eq '--display' ) {
            $o{display} = $need->( $a, $argv[ ++$i ] );
        }
        elsif ( $a eq '--width' ) {
            $o{width} = $need->( $a, $argv[ ++$i ] );
        }
        elsif ( $a eq '--height' ) {
            $o{height} = $need->( $a, $argv[ ++$i ] );
        }
        elsif ( $a eq '--unveil' ) {
            $o{unveil} = $need->( $a, $argv[ ++$i ] );
        }
        elsif ( $a eq '--amnesiac' ) { $o{amnesiac} = 1 }
        elsif ( $a eq '--verbose' ) { $o{verbose} = 1 }
        else { $usage->() }
        $i++;
    }
    $usage->() unless $i < @argv && $argv[$i] eq '--';
    my @app = @argv[ $i + 1 .. $#argv ];
    die "no application specified\n" unless @app;
    die "too many application arguments\n" if @app > 256;

    my ($pd) = $o{parent_display} =~ /\A(:[0-9]{1,4}(?:\.[0-9]{1,4})?)\z/
      or die "invalid parent display '$o{parent_display}'\n";
    $o{parent_display} = $pd;

    my $px = _untaint( $o{parent_xauth}, 'parent Xauthority path' );
    die "parent Xauthority path must be absolute\n" unless $px =~ m{\A/};
    die "parent Xauthority path too long\n" if length($px) > 4096;
    $o{parent_xauth} = $px;

    if ( exists $o{display} ) {
        my ($n) = $o{display} =~ /\A([0-9]{1,3})\z/
          or die "invalid display '$o{display}'\n";
        die "display must be in 1..$MAX_DISPLAY\n"
          unless $n >= 1 && $n <= $MAX_DISPLAY;
        $o{display} = 0 + $n;
    }
    else { $o{display} = 32 }

    for my $what (qw(width height)) {
        $o{$what} //= $what eq 'width' ? 1024 : 768;
        my ($n) = $o{$what} =~ /\A([0-9]{1,5})\z/
          or die "invalid $what '$o{$what}'\n";
        die "$what must be in 1..32767\n" unless $n >= 1 && $n <= 32767;
        $o{$what} = $n;
    }

    if ( defined $o{unveil} && length $o{unveil} ) {
        my @entries = split /,/, $o{unveil};
        die "too many unveil entries\n" if @entries > 64;
        my @clean;
        for my $entry (@entries) {
            my ( $path, $perm ) = $entry =~ /\A([^:]+):([rwxc]+)\z/
              or die "invalid unveil entry '$entry'\n";
            $path = _untaint( $path, 'unveil path' );
            die "unveil path must be absolute\n" unless $path =~ m{\A/};
            die "unveil path too long\n" if length($path) > 1024;
            push @clean, "$path:$perm";
        }
        $o{unveil} = \@clean;
    }
    else { $o{unveil} = [] }

    my $app = _untaint( shift @app, 'application path' );
    die "application path must be absolute\n" unless $app =~ m{\A/};
    die "application path too long\n" if length($app) > 4096;
    my @args = map { _untaint( $_, 'application argument' ) } @app;
    for my $arg (@args) {
        die "application argument too long\n" if length($arg) > 4096;
    }
    $o{app}      = $app;
    $o{app_args} = \@args;
    $o{amnesiac} ||= 0;

    $VERBOSE = $o{verbose};
    return \%o;
}

sub socket_path {
    my ($n) = @_;
    return "$SOCKET_DIR/X$n";
}

sub path_exists {
    my ($path) = @_;
    return lstat($path) ? 1 : ( $!{ENOENT} ? 0 : die "lstat $path: $!" );
}

sub find_free_display {
    my ( $start, $exists ) = @_;
    for my $n ( $start .. $MAX_DISPLAY ) {
        return $n unless $exists->($n);
    }
    return undef;
}

#
# Xephyr command line. The outer window is resizable like an ordinary
# application window: -screen provides the INITIAL size only, and
# -resizeable lets the host WM resize the window; Xephyr then resizes
# the nested screen through RandR (ephyrProcessConfigureNotify ->
# ephyrResizeScreen -> RRScreenSizeNotify in the Xserver source).
#
# -no-host-grab removes Xephyr's manual ctrl+shift keyboard/pointer
# host grab (the only input manipulation Xephyr performs; see
# ephyrProcessKeyRelease in the Xserver source). That grab state
# machine is triggered by common browser shortcuts (ctrl+shift+U opens
# the Tor Browser circuit display) and is a documented source of input
# trouble in nested sessions. It serves no security purpose here:
# event delivery stays a plain pass-through either way and MIT-MAGIC-
# COOKIE-1 authentication is unaffected.
#
sub build_xephyr_argv {
    my (%s) = @_;
    return (
        $XEPHYR_BIN,
        '-auth', $s{server_auth},
        '-screen', "$s{width}x$s{height}",
        '-br',
        '-nolisten', 'tcp',
        '-noreset',
        '-resizeable',
        '-no-host-grab',
        $s{display},
    );
}

#
# Amnesiac-mode helpers. Account names are strictly generated:
# never influenced by caller input beyond the random token.
#
sub gen_account_name {
    my ($token) = @_;
    $token =~ /\A([0-9a-f]{$EPHEMERAL_TOKEN_LEN})\z/
      or die "invalid account token\n";
    return $EPHEMERAL_PREFIX . $1;
}

sub ephemeral_home_for {
    my ($user) = @_;
    return "$EPHEMERAL_HOME_BASE/$user";
}

sub build_useradd_argv {
    my ( $user, $home ) = @_;
    return (
        $USERADD_BIN,
        '-d', $home,
        '-g', '=uid',
        '-s', $EPHEMERAL_SHELL,
        $user,
    );
}

sub build_userdel_argv {
    my ($user) = @_;
    return ( $USERDEL_BIN, $user );
}

sub build_groupdel_argv {
    my ($group) = @_;
    return ( $GROUPDEL_BIN, $group );
}

sub build_pkill_argv {
    my ( $signal, $uid ) = @_;
    die "invalid signal\n" unless $signal =~ /\A(?:TERM|KILL|0)\z/;
    die "invalid uid\n" unless $uid =~ /\A[1-9][0-9]*\z/;
    return ( $PKILL_BIN, "-$signal", '-U', $uid, '.' );
}

#
# Conservative check before recursive deletion of an ephemeral home.
# The path must be exactly the one derived from the account name, a
# real directory, not a symlink, and owned by the expected UID.
#
sub home_safe_to_delete {
    my ( $home, $user, $uid, $lstat_cb ) = @_;
    $lstat_cb //= sub { lstat $_[0] };
    return 0 unless $home eq ephemeral_home_for($user);
    my @st = $lstat_cb->($home);
    return 0 unless @st;
    return 0 unless ( $st[2] & S_IFMT ) == S_IFDIR;
    return 0 unless $st[4] == $uid;
    return 1;
}

#
# Xauthority record handling. MIT-MAGIC-COOKIE-1 cookies are never
# passed on command lines; only through mode-0600 files owned by the
# intended reader.
#
sub xauth_record_bytes {
    my ($r) = @_;
    die "authority record too long\n"
      if length( $r->{address} ) > $MAX_AUTH_LEN
      || length( $r->{number} ) > $MAX_AUTH_LEN
      || length( $r->{name} ) > $MAX_AUTH_LEN
      || length( $r->{data} ) > $MAX_AUTH_LEN;
    return pack(
        'n n a' . length( $r->{address} )
          . ' n a' . length( $r->{number} )
          . ' n a' . length( $r->{name} )
          . ' n a' . length( $r->{data} ),
        $r->{family}, length( $r->{address} ), $r->{address},
        length( $r->{number} ),  $r->{number},
        length( $r->{name} ),    $r->{name},
        length( $r->{data} ),    $r->{data},
    );
}

sub write_xauth_file {
    my ( $path, $records ) = @_;
    sysopen( my $fh, $path, O_CREAT | O_EXCL | O_WRONLY, 0600 )
      or die "open $path: $!";
    for my $r ( @{$records} ) {
        my $bytes = xauth_record_bytes($r);
        syswrite( $fh, $bytes ) == length($bytes)
          or die "write $path: $!";
    }
    close $fh or die "close $path: $!";
}

sub parse_xauth_bytes {
    my ($data) = @_;
    my @records;
    my $pos  = 0;
    my $size = length $data;
    while ( $pos < $size ) {
        die "truncated Xauthority record\n" if $size - $pos < 6;
        my ($family) = unpack( 'n', substr( $data, $pos, 2 ) );
        $pos += 2;
        my %r = ( family => $family );
        for my $field (qw(address number name data)) {
            die "truncated Xauthority $field length\n"
              if $size - $pos < 2;
            my ($len) = unpack( 'n', substr( $data, $pos, 2 ) );
            $pos += 2;
            die "Xauthority $field too long\n" if $len > $MAX_AUTH_LEN;
            die "truncated Xauthority $field\n" if $size - $pos < $len;
            $r{$field} = substr( $data, $pos, $len );
            $pos += $len;
        }
        push @records, \%r;
    }
    return \@records;
}

sub read_xauth_file {
    my ($path) = @_;
    sysopen( my $fh, $path, O_RDONLY )
      or die "open $path: $!";
    my $data = '';
    my $size = 0;
    my $buf  = '';
    while ( sysread( $fh, $buf, 4096 ) ) {
        $size += length $buf;
        die "$path exceeds size limit\n" if $size > $MAX_XAUTH;
        $data .= $buf;
    }
    defined $buf or die "read $path: $!";
    close $fh or die "close $path: $!";
    return parse_xauth_bytes($data);
}

sub parent_display_number {
    my ($display) = @_;
    my ($n) = $display =~ /\A:([0-9]+)(?:\.[0-9]+)?\z/
      or die "invalid display '$display'\n";
    return $n;
}

sub extract_parent_auth {
    my ( $records, $display ) = @_;
    my $number = parent_display_number($display);
    my @matched = grep {
        $_->{number} eq $number
          && $_->{name} eq 'MIT-MAGIC-COOKIE-1'
    } @{$records};
    for my $r (@matched) {
        die "invalid MIT-MAGIC-COOKIE-1 length\n"
          unless length( $r->{data} ) == $COOKIE_LEN;
    }
    return \@matched;
}

sub xauth_records_for {
    my ( $host, $number, $cookie ) = @_;
    my $data = pack( 'H*', $cookie );
    return [
        {
            family  => FAMILY_LOCAL,
            address => $host,
            number  => $number,
            name    => 'MIT-MAGIC-COOKIE-1',
            data    => $data,
        },
        {
            family  => FAMILY_WILD,
            address => '',
            number  => $number,
            name    => 'MIT-MAGIC-COOKIE-1',
            data    => $data,
        },
    ];
}

sub gen_cookie {
    my ($fh) = @_;
    my $buf = '';
    if ($fh) {
        sysread( $fh, $buf, $COOKIE_LEN ) == $COOKIE_LEN
          or die "short read from random source\n";
    }
    else {
        sysopen( my $rfh, '/dev/urandom', O_RDONLY )
          or die "open /dev/urandom: $!";
        sysread( $rfh, $buf, $COOKIE_LEN ) == $COOKIE_LEN
          or die "short read from /dev/urandom\n";
        close $rfh;
    }
    my ($hex) = unpack( 'H*', $buf ) =~ /\A([0-9a-f]{32})\z/
      or die "invalid random data\n";
    return $hex;
}

#
# Sanitized environments. Built from scratch; nothing from the
# invoking user's environment is inherited except an explicit
# whitelist of harmless variables.
#
sub _passthrough {
    my ($env) = @_;
    my %copy;
    for my $k (@PASSTHROUGH_ENV) {
        $copy{$k} = $env->{$k} if defined $env->{$k} && length $env->{$k};
    }
    return \%copy;
}

sub build_app_env {
    my (%s) = @_;
    my $env = {
        PATH            => $s{path} // $APP_PATH,
        HOME            => $s{home},
        USER            => $s{username},
        LOGNAME         => $s{username},
        SHELL           => $s{shell} // '/bin/ksh',
        DISPLAY         => $s{display},
        XAUTHORITY      => $s{xauthority},
        XDG_RUNTIME_DIR => $s{runtime_dir},
    };
    for my $k (@PASSTHROUGH_ENV) {
        $env->{$k} = $s{passthru}{$k} if defined $s{passthru}{$k};
    }
    return $env;
}

sub build_xephyr_env {
    my (%s) = @_;
    my $env = {
        PATH       => $MINIMAL_PATH,
        HOME       => $s{home},
        DISPLAY    => $s{display},
        XAUTHORITY => $s{xauthority},
    };
    for my $k (@PASSTHROUGH_ENV) {
        $env->{$k} = $s{passthru}{$k} if defined $s{passthru}{$k};
    }
    return $env;
}

sub build_unveil_entries {
    my (%s) = @_;
    my @entries = @{ $s{user_entries} // [] };
    push @entries, "$s{socket_path}:w";
    push @entries, "$s{client_auth}:r";
    push @entries, "$s{runtime_dir}:rwxc";
    return \@entries;
}

sub make_session_dir {
    for ( 1 .. 32 ) {
        open my $fh, '<', '/dev/urandom' or die "open /dev/urandom: $!";
        my $buf = '';
        sysread( $fh, $buf, 16 ) == 16
          or die "short read from /dev/urandom\n";
        close $fh;
        my ($name) = unpack( 'H*', $buf ) =~ /\A([0-9a-f]{32})\z/
          or die "invalid random data\n";
        my $path = "$RUN_DIR/$name";
        if ( mkdir $path, 0700 ) {
            chmod 0711, $path or die "chmod $path: $!";
            return $path;
        }
        die "mkdir $path: $!" unless $!{EEXIST};
    }
    die "cannot create a session directory under $RUN_DIR\n";
}

sub exit_status {
    my ($status) = @_;
    return 1                           if $status == -1;
    return 128 + ( $status & 127 )     if $status & 127;
    return $status >> 8;
}

#
# Privilege transition. Runs only as OpenBSD root. After this the
# process can never regain any privilege; every step is verified.
#
sub drop_privs {
    my ( $uid, $gid ) = @_;
    return 0 unless $^O eq 'openbsd';
    return 0 unless getuid() == 0 && geteuid() == 0;

    $! = 0;
    $) = "$gid $gid";    # effective gid + supplementary groups
    return 0 if $!;
    return 0 unless getegid() == $gid;
    $! = 0;
    $( = $gid;           # real gid
    return 0 if $!;
    setgid($gid) == 0 or return 0;
    setuid($uid) == 0 or return 0;

    getuid()  == $uid or return 0;
    geteuid() == $uid or return 0;
    getgid()  == $gid or return 0;
    getegid() == $gid or return 0;
    my @groups = getgroups();
    @groups == 1 && $groups[0] == $gid or return 0;

    # Saved credentials must be gone as well; attempting to regain
    # root must fail.
    setuid(0) == 0 and return 0;
    return 1;
}

#
# Session orchestration. Requires root (invoked through doas).
#
sub run {
    my (@argv) = @_;

    $^O eq 'openbsd'
      or die "xsunaba-helper runs on OpenBSD only\n";
    getuid() == 0 && geteuid() == 0
      or die "xsunaba-helper must be invoked through doas as root\n";

    my $opts = parse_args(@argv);

    # Private defaults for everything this session creates: the
    # application inherits this umask, so its own files and
    # directories default to 0600/0700. Applications may still chmod
    # their own objects later; the umask is a default, not an
    # access-control policy.
    umask 077;

    # Load the pledge/unveil bindings now so the children do not need
    # filesystem access after their privileges are dropped.
    require OpenBSD::Pledge;
    require OpenBSD::Unveil;

    # Scrub the environment. doas already built a fresh one; keep only
    # what the children genuinely may receive.
    my $passthru = _passthrough( \%ENV );
    my $doas_user = $ENV{DOAS_USER};
    %ENV = ();
    $ENV{PATH} = $MINIMAL_PATH;

    # The invoking user (as reported by doas) must own the parent
    # Xauthority file. This prevents a login user from using the root
    # helper to extract records from authority files of other users.
    if ( defined $doas_user && length $doas_user ) {
        my ($user) = $doas_user =~ /\A([a-z_][a-z0-9_-]{0,30})\z/
          or die "invalid DOAS_USER\n";
        my @pw = getpwnam($user) or die "DOAS_USER '$user' unknown\n";
        my @st = stat $opts->{parent_xauth}
          or die "stat $opts->{parent_xauth}: $!\n";
        -f _
          or die "$opts->{parent_xauth} is not a regular file\n";
        $st[4] == $pw[2]
          or die "$opts->{parent_xauth} is not owned by '$user'\n";
    }

    my $xephyr = getpwnam($XEPHYR_USER)
      or die "user $XEPHYR_USER missing; run 'doas make install-users'\n";
    die "$XEPHYR_USER must not be root\n" if $xephyr->uid == 0;

    # Application identity: persistent dedicated account or, in
    # amnesiac mode, a fresh account created further below.
    my $app_uid;
    my $app_gid;
    my $app_home;
    my $app_shell;
    my $app_username;
    my $socket_gid;
    my $am = { amnesiac => $opts->{amnesiac} };

    if ( $opts->{amnesiac} ) {
        $app_username = undef;
    }
    else {
        my $app = getpwnam($APP_USER)
          or die "user $APP_USER missing; run 'doas make install-users'\n";
        my $appgrp = getgrnam($APP_GROUP)
          or die "group $APP_GROUP missing; run 'doas make install-users'\n";
        die "$APP_USER must not be root\n" if $app->uid == 0;
        die "$XEPHYR_USER and $APP_USER share a UID\n"
          if $xephyr->uid == $app->uid;
        die "primary group of $APP_USER must be $APP_GROUP\n"
          unless $app->gid == $appgrp->gid;
        $app_uid      = $app->uid;
        $app_gid      = $app->gid;
        $app_home     = $app->dir;
        $app_shell    = $app->shell;
        $app_username = $APP_USER;
        $socket_gid   = $appgrp->gid;
    }

    _ensure_run_dir();
    reap_stale_sessions() if $opts->{amnesiac};

    # Serialize display allocation and hold the lock until the socket
    # is created, so two helpers can never claim the same display.
    sysopen( my $lock, "$RUN_DIR/display.lock", O_CREAT | O_RDWR, 0600 )
      or die "open $RUN_DIR/display.lock: $!";
    flock( $lock, LOCK_EX ) or die "flock: $!";

    my $display = find_free_display(
        $opts->{display},
        sub { path_exists( socket_path( $_[0] ) ) },
    );
    die "no free X display from :$opts->{display} through :$MAX_DISPLAY\n"
      unless defined $display;
    my $socket = socket_path($display);

    my $session = make_session_dir();
    my $xephyr_dir = "$session/xephyr";
    my $app_dir    = "$session/app";
    my $run_dir    = "$app_dir/run";

    my $xephyr_pid;
    my $app_pid;
    my $aborted = 0;

    my $fatal = sub {
        my ($msg) = @_;
        _err $msg;
        if ($xephyr_pid) {
            kill 'TERM', $xephyr_pid;
            select undef, undef, undef, 0.1;
            kill 'KILL', $xephyr_pid;
            waitpid( $xephyr_pid, 0 );
        }
        if ($app_pid) {
            kill 'TERM', $app_pid;
            select undef, undef, undef, 0.1;
            kill 'KILL', $app_pid;
            waitpid( $app_pid, 0 );
        }
        if ( lstat $socket && -S _ && ( stat _ )[4] == $xephyr->uid ) {
            unlink $socket or _wrn "cannot remove $socket: $!";
        }
        if ( $am->{amnesiac} ) {
            _amnesiac_teardown( $am, $session );
        }
        else {
            remove_tree( $session, { safe => 1 } );
        }
        exit 1;
    };

    local $SIG{INT} = local $SIG{TERM} = local $SIG{HUP} = sub {
        $aborted = 1;
        kill 'TERM', $xephyr_pid if $xephyr_pid;
        kill 'TERM', $app_pid    if $app_pid;
    };
    # Deterministic SIGUSR1 disposition: Xephyr notifies the parent
    # only when it inherited SIG_IGN; we want the default so that no
    # signal race exists.
    local $SIG{USR1} = 'DEFAULT';

    # Amnesiac mode: the session is reaper-visible from the moment the
    # active lock is held, so an interrupted creation is recovered by
    # the next invocation.
    if ( $opts->{amnesiac} ) {
        sysopen( my $alock, "$session/active.lock", O_CREAT | O_RDWR, 0600 )
          or $fatal->("open $session/active.lock: $!");
        flock( $alock, LOCK_EX ) or $fatal->("flock: $!");
        $am->{lock_fh} = $alock;
        _amnesiac_create( $am, $session, $xephyr, $fatal );
        $app_uid   = $am->{uid};
        $app_gid   = $am->{gid};
        $app_home  = $am->{home};
        $app_shell = $EPHEMERAL_SHELL;
        $app_username = $am->{user};
        $socket_gid = $am->{gid};
    }

    mkdir $xephyr_dir, 0700 or $fatal->("mkdir $xephyr_dir: $!");
    chown( $xephyr->uid, $xephyr->gid, $xephyr_dir ) == 1
      or $fatal->("chown $xephyr_dir: $!");
    mkdir $app_dir, 0700 or $fatal->("mkdir $app_dir: $!");
    chown( $app_uid, $app_gid, $app_dir ) == 1
      or $fatal->("chown $app_dir: $!");
    mkdir $run_dir, 0700 or $fatal->("mkdir $run_dir: $!");
    chown( $app_uid, $app_gid, $run_dir ) == 1
      or $fatal->("chown $run_dir: $!");

    my $parent_auth = "$xephyr_dir/parent-auth";
    my $server_auth = "$xephyr_dir/server-auth";
    my $client_auth = "$app_dir/client-auth";

    # Parent-display credentials for Xephyr: only the records for the
    # requested DISPLAY, never the complete authority database.
    {
        my $records = eval { read_xauth_file( $opts->{parent_xauth} ) };
        $fatal->("$@") if $@;
        my $matched =
          eval { extract_parent_auth( $records, $opts->{parent_display} ) };
        $fatal->("$@") if $@;
        @$matched
          or $fatal->(
            "no MIT-MAGIC-COOKIE-1 entry for "
              . "$opts->{parent_display} in $opts->{parent_xauth}" );
        write_xauth_file( $parent_auth, $matched );
        chown( $xephyr->uid, $xephyr->gid, $parent_auth ) == 1
          or $fatal->("chown $parent_auth: $!");
    }

    # Nested-display credentials: one fresh random cookie per session,
    # duplicated into separate authority files for Xephyr (server) and
    # the application (client). Never exposed to the login user.
    my $cookie = eval { gen_cookie() };
    $fatal->("$@") if $@;
    my $host = eval { _hostname() };
    $fatal->("$@") if $@;
    my $records = xauth_records_for( $host, $display, $cookie );

    write_xauth_file( $server_auth, $records );
    chown( $xephyr->uid, $xephyr->gid, $server_auth ) == 1
      or $fatal->("chown $server_auth: $!");
    write_xauth_file( $client_auth, $records );
    chown( $app_uid, $app_gid, $client_auth ) == 1
      or $fatal->("chown $client_auth: $!");

    _inf "using display :$display";
    _inf "session directory $session";
    _inf "amnesiac account $am->{user}" if $opts->{amnesiac};

    # --- Xephyr, as the dedicated Xephyr UID ---
    $xephyr_pid = fork();
    defined $xephyr_pid or $fatal->("fork: $!");
    if ( $xephyr_pid == 0 ) {
        delete $SIG{$_} for keys %SIG;
        chdir $xephyr_dir
          or _err("chdir $xephyr_dir: $!"), _exit(1);
        %ENV = %{
            build_xephyr_env(
                display    => $opts->{parent_display},
                xauthority => $parent_auth,
                home       => $xephyr_dir,
                passthru   => $passthru,
            )
        };
        drop_privs( $xephyr->uid, $xephyr->gid )
          or _err( "failed to drop privileges for Xephyr" ), _exit(1);
        {
            exec build_xephyr_argv(
                display     => ":$display",
                width       => $opts->{width},
                height      => $opts->{height},
                server_auth => $server_auth,
            );
        }
        _err "exec $XEPHYR_BIN: $!";
        _exit(1);
    }
    _inf "Xephyr started (PID $xephyr_pid)";

    # --- Wait for the socket, then restrict it ---
    _wait_for_socket(
        $socket, $xephyr_pid, $xephyr->uid, $socket_gid, $fatal,
    );
    close $lock;
    _inf "socket $socket restricted to "
      . sprintf( '%o', $SOCKET_MODE );

    # --- Application, as the dedicated application UID ---
    $app_pid = fork();
    defined $app_pid or $fatal->("fork: $!");
    if ( $app_pid == 0 ) {
        delete $SIG{$_} for keys %SIG;
        chdir $app_home
          or _err("chdir $app_home: $!"), _exit(1);
        %ENV = %{
            build_app_env(
                display     => ":$display",
                xauthority  => $client_auth,
                home        => $app_home,
                shell       => $app_shell,
                username    => $app_username,
                runtime_dir => $run_dir,
                passthru    => $passthru,
            )
        };
        drop_privs( $app_uid, $app_gid )
          or _err( "failed to drop privileges for the application" ),
             _exit(1);
        if ( @{ $opts->{unveil} } ) {
            my @entries = @{
                build_unveil_entries(
                    socket_path => $socket,
                    client_auth => $client_auth,
                    runtime_dir => $run_dir,
                    user_entries => $opts->{unveil},
                )
            };
            for my $entry (@entries) {
                my ( $path, $perm ) = split /:/, $entry, 2;
                OpenBSD::Unveil::unveil( $path, $perm )
                  or _err( "unveil($path): $!" ), _exit(1);
            }
            OpenBSD::Unveil::unveil()
              or _err("unveil lock: $!"), _exit(1);
        }
        { exec $opts->{app}, @{ $opts->{app_args} } }
        _err "exec $opts->{app}: $!";
        _exit(1);
    }
    _inf "launched '$opts->{app}' (PID $app_pid)";

    # The helper no longer needs to fork, execute or write files other
    # than during teardown. exec/getpw cover the account-management
    # commands (userdel/groupdel/pkill) and passwd-database lookups
    # used by amnesiac cleanup. Fail closed: a failed pledge tears the
    # session down.
    unless (
        OpenBSD::Pledge::pledge(
            'stdio rpath cpath fattr proc exec getpw'
        )
      )
    {
        $fatal->("pledge failed: $!");
    }

    # --- Wait for the application ---
    my $app_status;
    while (1) {
        my $pid = waitpid( -1, 0 );
        if ( $pid == $app_pid ) {
            $app_status = $?;
            last;
        }
        if ( $pid == $xephyr_pid ) {
            _err "Xephyr exited unexpectedly";
            $app_status = 1;
            $aborted    = 1;
            last;
        }
        last if $pid < 0;
    }

    if ($aborted && $app_pid) {
        kill 'TERM', $app_pid;
        _stop_child( $app_pid, 'the application' );
    }

    _stop_xephyr( $xephyr_pid, $socket, $xephyr->uid );

    if ( $opts->{amnesiac} ) {
        _amnesiac_teardown( $am, $session );
    }
    else {
        remove_tree( $session, { safe => 1 } );
    }
    _inf "cleanup complete";
    return exit_status( defined $app_status ? $app_status : 1 );
}

sub _ensure_run_dir {
    if ( mkdir $RUN_DIR, 0711 ) {
        chmod 0711, $RUN_DIR or die "chmod $RUN_DIR: $!";
        return;
    }
    die "mkdir $RUN_DIR: $!" unless $!{EEXIST};
    my @st = lstat $RUN_DIR or die "lstat $RUN_DIR: $!";
    -d _ or die "$RUN_DIR exists and is not a directory\n";
    $st[4] == 0 or die "$RUN_DIR is not owned by root\n";
    ( $st[2] & 022 ) == 0 or die "$RUN_DIR is group or world writable\n";
    chmod 0711, $RUN_DIR or die "chmod $RUN_DIR: $!";
}

sub _hostname {
    my $host = hostname();
    my ($clean) = $host =~ /\A([[:alnum:].-]{1,255})\z/
      or die "invalid hostname\n";
    return $clean;
}

#
# Run an external command with execve-style arguments (no shell) and
# return its exit status. Only used with fixed, validated argv built
# by the amnesiac helpers. Returns -1 if the child cannot be forked;
# never dies, so cleanup paths cannot be interrupted.
#
sub _run_cmd {
    my (@argv) = @_;
    my $pid = fork();
    unless ( defined $pid ) {
        _wrn "fork: $!";
        return -1;
    }
    if ( $pid == 0 ) {
        delete $SIG{$_} for keys %SIG;
        { exec @argv }
        _err "exec $argv[0]: $!";
        _exit(127);
    }
    waitpid( $pid, 0 );
    return $? == -1 ? -1 : ( $? >> 8 );
}

sub _ensure_ephemeral_bases {
    for my $dir ( '/var/xsunaba', $EPHEMERAL_HOME_BASE ) {
        if ( mkdir $dir, 0711 ) {
            chmod 0711, $dir or die "chmod $dir: $!";
            next;
        }
        die "mkdir $dir: $!" unless $!{EEXIST};
        my @st = lstat $dir or die "lstat $dir: $!";
        -d _ or die "$dir exists and is not a directory\n";
        $st[4] == 0 or die "$dir is not owned by root\n";
        ( $st[2] & 022 ) == 0 or die "$dir is group or world writable\n";
        chmod 0711, $dir or die "chmod $dir: $!";
    }
}

#
# Amnesiac account creation. Everything derived from a random token;
# nothing comes from caller input. Track exactly what was created so
# teardown never touches anything else.
#
sub _amnesiac_create {
    my ( $am, $session, $xephyr, $fatal ) = @_;

    {
        my $rc = eval { _ensure_ephemeral_bases() };
        $fatal->("$@") if $@;
    }

    my ( $user, $uid, $gid, $home );
    for ( 1 .. 3 ) {
        my $token = eval { _random_hex( $EPHEMERAL_TOKEN_LEN / 2 ) };
        $fatal->("$@") if $@;
        $user = eval { gen_account_name($token) };
        $fatal->("$@") if $@;
        $home = ephemeral_home_for($user);
        my $rc = _run_cmd( build_useradd_argv( $user, $home ) );
        if ( $rc == 0 ) {
            $am->{user_created} = 1;
            last;
        }
        $user = undef;
    }
    $fatal->("useradd failed for amnesiac account")
      unless $am->{user_created};

    my @pw = getpwnam($user) or $fatal->("cannot resolve $user");
    $uid  = $pw[2];
    $gid  = $pw[3];
    $home = $pw[7];
    $fatal->("amnesiac account $user has uid 0") if $uid == 0;
    $fatal->("amnesiac account $user has gid 0") if $gid == 0;
    $fatal->("amnesiac account $user shares the Xephyr UID")
      if $uid == $xephyr->uid;
    $fatal->("unexpected home '$home' for $user")
      unless $home eq ephemeral_home_for($user);

    # Record the identity as soon as it is known so teardown covers
    # every partially completed step below.
    $am->{user} = $user;
    $am->{uid}  = $uid;
    $am->{gid}  = $gid;
    $am->{home} = $home;

    mkdir $home, 0700 or $fatal->("mkdir $home: $!");
    chown( $uid, $gid, $home ) == 1 or $fatal->("chown $home: $!");
    $am->{home_created} = 1;

    # Record the account in the session dir so stale-session reaping
    # can map a session to its account.
    sysopen( my $af, "$session/account", O_CREAT | O_EXCL | O_WRONLY, 0600 )
      or $fatal->("open $session/account: $!");
    print {$af} "$user\n" or $fatal->("write $session/account: $!");
    close $af or $fatal->("close $session/account: $!");
}

#
# Amnesiac teardown. Ordered: processes first (bounded by the unique
# ephemeral UID), then session state, then the verified home, then
# the account and its private group. Never deletes anything whose
# identity was not recorded by this session.
#
sub _amnesiac_teardown {
    my ( $am, $session ) = @_;

    if ( $am->{lock_fh} ) {
        close delete $am->{lock_fh};
    }

    my $procs_gone = 1;
    if ( $am->{uid} ) {
        _run_cmd( build_pkill_argv( 'TERM', $am->{uid} ) );
        select undef, undef, undef, 0.1;
        _run_cmd( build_pkill_argv( 'KILL', $am->{uid} ) );
        my $alive = _run_cmd( build_pkill_argv( '0', $am->{uid} ) );
        if ( $alive == 0 ) {
            _wrn "processes still run as $am->{user}; "
              . "account not removed to avoid UID reuse";
            $procs_gone = 0;
        }
    }

    remove_tree( $session, { safe => 1 } );

    if ( $am->{home_created}
        && home_safe_to_delete( $am->{home}, $am->{user}, $am->{uid} ) )
    {
        remove_tree( $am->{home}, { safe => 1 } );
    }
    else {
        _wrn "refusing to remove home of $am->{user}";
    }

    return unless $procs_gone;

    if ( $am->{user_created} ) {
        _run_cmd( build_userdel_argv( $am->{user} ) ) == 0
          or _wrn "userdel $am->{user} failed; stale account left";
    }

    if ( $am->{gid} && $am->{user} ) {
        my $grp = getgrnam( $am->{user} );
        if ( $grp
            && $grp->gid == $am->{gid}
            && !@{ $grp->members // [] } )
        {
            _run_cmd( build_groupdel_argv( $am->{user} ) ) == 0
              or _wrn "groupdel $am->{user} failed";
        }
    }
}

#
# Conservative stale-session recovery. Only considers session
# directories that contain active.lock (amnesiac sessions), and only
# when their flock is free (the owning helper is gone). Never touches
# accounts that merely resemble the naming scheme: the session's own
# account file must name the account, and the account name pattern,
# home path and home ownership must all verify.
#
sub reap_stale_sessions {
    sysopen( my $glock, "$RUN_DIR/reaper.lock", O_CREAT | O_RDWR, 0600 )
      or die "open $RUN_DIR/reaper.lock: $!";
    flock( $glock, LOCK_EX ) or die "flock reaper: $!";

    opendir( my $dh, $RUN_DIR ) or die "opendir $RUN_DIR: $!";
    my @tokens = grep { /\A[0-9a-f]{32}\z/ } readdir $dh;
    closedir $dh;

    for my $token (@tokens) {
        my $dir = "$RUN_DIR/$token";
        lstat $dir or next;
        -d _ or next;
        next unless -e "$dir/active.lock";
        sysopen( my $lfh, "$dir/active.lock", O_RDWR ) or next;
        flock( $lfh, LOCK_EX | LOCK_NB ) or next;    # live session

        my $user;
        if ( open my $af, '<', "$dir/account" ) {
            local $/;
            $user = <$af>;
            close $af;
            chomp $user if defined $user;
        }
        if ( defined $user
            && $user =~ /\A\Q$EPHEMERAL_PREFIX\E[0-9a-f]{16}\z/
            && ( my @pw = getpwnam($user) ) )
        {
            my ( $uid, $gid ) = @pw[ 2, 3 ];
            _run_cmd( build_pkill_argv( 'TERM', $uid ) );
            select undef, undef, undef, 0.1;
            _run_cmd( build_pkill_argv( 'KILL', $uid ) );
            my $alive = _run_cmd( build_pkill_argv( '0', $uid ) );
            if ( $alive != 0 ) {
                my $home = ephemeral_home_for($user);
                if ( $pw[7] eq $home
                    && home_safe_to_delete( $home, $user, $uid ) )
                {
                    remove_tree( $home, { safe => 1 } );
                }
                _run_cmd( build_userdel_argv($user) );
                my $grp = getgrnam($user);
                if ( $grp
                    && $grp->gid == $gid
                    && !@{ $grp->members // [] } )
                {
                    _run_cmd( build_groupdel_argv($user) );
                }
            }
            else {
                _wrn "processes still run as $user; account not removed";
            }
        }
        remove_tree( $dir, { safe => 1 } );
        _wrn "reaped stale amnesiac session"
          . ( defined $user ? " $user" : '' );
        close $lfh;
    }
    close $glock;
}

sub _random_hex {
    my ($bytes) = @_;
    sysopen( my $fh, '/dev/urandom', O_RDONLY )
      or die "open /dev/urandom: $!";
    my $buf = '';
    sysread( $fh, $buf, $bytes ) == $bytes
      or die "short read from /dev/urandom\n";
    close $fh;
    my ($hex) = unpack( 'H*', $buf ) =~ /\A([0-9a-f]+)\z/
      or die "invalid random data\n";
    return $hex;
}

sub _wait_for_socket {
    my ( $socket, $pid, $uid, $gid, $fatal ) = @_;
    for ( 1 .. 300 ) {
        my $reaped = waitpid( $pid, WNOHANG );
        $fatal->("Xephyr exited before opening $socket")
          if $reaped == $pid;
        if ( lstat $socket ) {
            -S _ or $fatal->("$socket exists but is not a socket");
            my $owner = ( stat _ )[4];
            $fatal->("$socket is not owned by the Xephyr UID")
              unless $owner == $uid;
            chown( $uid, $gid, $socket ) == 1
              or $fatal->("chown $socket: $!");
            chmod( $SOCKET_MODE, $socket ) == 1
              or $fatal->("chmod $socket: $!");
            my @st = lstat $socket
              or $fatal->("lstat $socket: $!");
            $fatal->("failed to restrict $socket")
              unless ( $st[2] & S_IFMT ) == S_IFSOCK
              && $st[4] == $uid
              && $st[5] == $gid
              && ( $st[2] & 0777 ) == $SOCKET_MODE;
            return;
        }
        $fatal->("lstat $socket: $!") unless $!{ENOENT};
        select undef, undef, undef, 0.05;
    }
    $fatal->("timed out waiting for Xephyr to open $socket");
}

sub _stop_child {
    my ( $pid, $what ) = @_;
    return unless $pid;
    kill 'TERM', $pid;
    for ( 1 .. 20 ) {
        my $reaped = waitpid( $pid, WNOHANG );
        last if $reaped == $pid || $reaped < 0;
        select undef, undef, undef, 0.1;
    }
    if ( waitpid( $pid, WNOHANG ) == 0 ) {
        kill 'KILL', $pid;
        waitpid( $pid, 0 );
    }
    _inf "stopped $what (PID $pid)";
}

sub _stop_xephyr {
    my ( $pid, $socket, $uid ) = @_;
    return unless $pid;
    kill 'TERM', $pid;
    for ( 1 .. 20 ) {
        my $reaped = waitpid( $pid, WNOHANG );
        last if $reaped == $pid || $reaped < 0;
        select undef, undef, undef, 0.1;
    }
    if ( waitpid( $pid, WNOHANG ) == 0 ) {
        kill 'KILL', $pid;
        waitpid( $pid, 0 );
    }
    _inf "stopped Xephyr (PID $pid)";
    if ( lstat $socket && -S _ && ( stat _ )[4] == $uid ) {
        unlink $socket or _wrn "cannot remove $socket: $!";
    }
}

package main;

unless (caller) {
    exit Xsunaba::Helper::run(@ARGV);
}

1;
